@page
@model PatioMulasApp.Pages.MovimientosModel

@{
    ViewData["Title"] = "Gestión de Movimientos";
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h1>🔄 Gestión de Movimientos</h1>
        <p>Registro de entradas y salidas de unidades del patio de mulas.</p>
    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h4>Registrar movimiento</h4>
        </div>

        <div class="card-body">

            <form method="post">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Tipo de movimiento
                        </label>

                        <select asp-for="Movimiento.TipoMovimiento"
                                class="form-select">

                            <option value="">Seleccione...</option>
                            <option value="Entrada">Entrada</option>
                            <option value="Salida">Salida</option>

                        </select>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Fecha y hora
                        </label>

                        <input asp-for="Movimiento.FechaHora"
                               type="datetime-local"
                               class="form-control" />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Unidad
                        </label>

                        <select asp-for="Movimiento.UnidadId"
                                class="form-select">

                            <option value="">Seleccione una unidad...</option>

                            @foreach (var unidad in Model.Unidades)
                            {
                                <option value="@unidad.Id">
                                    @unidad.Placa - @unidad.Marca @unidad.Modelo
                                </option>
                            }

                        </select>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Conductor
                        </label>

                        <select asp-for="Movimiento.ConductorId"
                                class="form-select">

                            <option value="">Seleccione un conductor...</option>

                            @foreach (var conductor in Model.Conductores)
                            {
                                <option value="@conductor.Id">
                                    @conductor.Nombre @conductor.Apellido
                                </option>
                            }

                        </select>

                    </div>


                    <div class="col-md-12 mb-3">

                        <label class="form-label">
                            Ubicación externa
                        </label>

                        <input asp-for="Movimiento.UbicacionExterna"
                               class="form-control"
                               placeholder="Ej. Terminal de Balboa" />

                    </div>


                    <div class="col-md-12 mb-3">

                        <label class="form-label">
                            Observación
                        </label>

                        <textarea asp-for="Movimiento.Observacion"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Observaciones del movimiento"></textarea>

                    </div>

                </div>


                <button type="submit"
                        class="btn btn-primary">

                    Registrar movimiento

                </button>

            </form>

        </div>

    </div>


    <div class="card shadow-sm">

        <div class="card-header">
            <h4>Movimientos registrados</h4>
        </div>

        <div class="card-body">

            <table class="table table-striped">

                <thead>

                    <tr>
                        <th>Tipo</th>
                        <th>Unidad</th>
                        <th>Conductor</th>
                        <th>Fecha y hora</th>
                        <th>Ubicación</th>
                        <th>Observación</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var movimiento in Model.Movimientos)
                    {
                        <tr>

                            <td>
                                @movimiento.TipoMovimiento
                            </td>

                            <td>
                                @Model.Unidades
                                    .FirstOrDefault(u => u.Id == movimiento.UnidadId)?.Placa
                            </td>

                            <td>
                                @{
                                    var conductor = Model.Conductores
                                        .FirstOrDefault(c => c.Id == movimiento.ConductorId);
                                }

                                @(conductor != null
                                    ? conductor.Nombre + " " + conductor.Apellido
                                    : "")
                            </td>

                            <td>
                                @movimiento.FechaHora.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @movimiento.UbicacionExterna
                            </td>

                            <td>
                                @movimiento.Observacion
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>