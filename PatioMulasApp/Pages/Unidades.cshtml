@page
@model PatioMulasApp.Pages.UnidadesModel

@{
    ViewData["Title"] = "Gestión de Unidades";
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h1>🚛 Gestión de Unidades</h1>
        <p>Registro, consulta y gestión de las unidades del patio de mulas.</p>
    </div>


    <!-- REGISTRAR UNIDAD -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h4>Registrar unidad</h4>
        </div>

        <div class="card-body">

            <form method="post">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Unidad.Placa" class="form-label">
                            Placa
                        </label>

                        <input asp-for="Unidad.Placa"
                               class="form-control"
                               placeholder="Ej. AJ2339" />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Unidad.Marca" class="form-label">
                            Marca
                        </label>

                        <input asp-for="Unidad.Marca"
                               class="form-control"
                               placeholder="Ej. Freightliner" />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Unidad.Modelo" class="form-label">
                            Modelo
                        </label>

                        <input asp-for="Unidad.Modelo"
                               class="form-control"
                               placeholder="Ej. Cascadia" />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Unidad.Año" class="form-label">
                            Año
                        </label>

                        <input asp-for="Unidad.Año"
                               type="number"
                               class="form-control"
                               placeholder="Ej. 2023" />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Unidad.Estado" class="form-label">
                            Estado
                        </label>

                        <select asp-for="Unidad.Estado"
                                class="form-select">

                            <option value="">
                                Seleccione...
                            </option>

                            <option>
                                Disponible
                            </option>

                            <option>
                                En patio
                            </option>

                            <option>
                                En mantenimiento
                            </option>

                            <option>
                                Fuera de servicio
                            </option>

                        </select>

                    </div>

                </div>


                <button type="submit"
                        class="btn btn-primary">

                    Registrar unidad

                </button>

            </form>

        </div>

    </div>



    <!-- BUSCADOR -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h4>🔎 Buscar unidad</h4>
        </div>

        <div class="card-body">

            <form method="get">

                <div class="row align-items-end">

                    <div class="col-md-8 mb-3">

                        <label asp-for="BuscarPlaca"
                               class="form-label">

                            Buscar por placa

                        </label>

                        <input asp-for="BuscarPlaca"
                               class="form-control"
                               placeholder="Ej. AJ2339" />

                    </div>


                    <div class="col-md-2 mb-3">

                        <button type="submit"
                                class="btn btn-secondary w-100">

                            🔎 Buscar

                        </button>

                    </div>


                    <div class="col-md-2 mb-3">

                        <a asp-page="/Unidades"
                           class="btn btn-outline-secondary w-100">

                            Ver todas

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>



    <!-- UNIDADES REGISTRADAS -->
    <div class="card shadow-sm">

        <div class="card-header">

            <h4>📋 Unidades registradas</h4>

        </div>


        <div class="card-body">

            @if (Model.Unidades.Count == 0)
            {
                <p class="text-muted">
                    No se encontraron unidades.
                </p>
            }
            else
            {

                <div class="table-responsive">

                    <table class="table table-striped table-bordered">

                        <thead>

                            <tr>

                                <th>ID</th>
                                <th>Placa</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Año</th>
                                <th>Estado</th>
                                <th>Acciones</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var unidad in Model.Unidades)
                            {

                                <tr>

                                    <td>
                                        @unidad.Id
                                    </td>

                                    <td>
                                        @unidad.Placa
                                    </td>

                                    <td>
                                        @unidad.Marca
                                    </td>

                                    <td>
                                        @unidad.Modelo
                                    </td>

                                    <td>
                                        @unidad.Año
                                    </td>

                                    <td>
                                        @unidad.Estado
                                    </td>


                                    <td>

                                        <!-- EDITAR -->

                                        <form method="post"
                                              asp-page-handler="Editar"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@unidad.Id" />

                                            <button type="submit"
                                                    class="btn btn-warning btn-sm">

                                                ✏️ Editar

                                            </button>

                                        </form>


                                        <!-- ELIMINAR -->

                                        <form method="post"
                                              asp-page-handler="Eliminar"
                                              class="d-inline"
                                              onsubmit="return confirm('¿Está seguro de que desea eliminar esta unidad?');">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@unidad.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm">

                                                🗑️ Eliminar

                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>



    <!-- FORMULARIO DE EDICIÓN -->

    @if (Model.Unidad.Id > 0)
    {

        <div class="card shadow-sm mt-4">

            <div class="card-header">

                <h4>✏️ Editar unidad</h4>

            </div>


            <div class="card-body">

                <form method="post"
                      asp-page-handler="GuardarCambios">

                    <input type="hidden"
                           asp-for="Unidad.Id" />


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="Unidad.Placa"
                                   class="form-label">

                                Placa

                            </label>

                            <input asp-for="Unidad.Placa"
                                   class="form-control" />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="Unidad.Marca"
                                   class="form-label">

                                Marca

                            </label>

                            <input asp-for="Unidad.Marca"
                                   class="form-control" />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="Unidad.Modelo"
                                   class="form-label">

                                Modelo

                            </label>

                            <input asp-for="Unidad.Modelo"
                                   class="form-control" />

                        </div>


                        <div class="col-md-3 mb-3">

                            <label asp-for="Unidad.Año"
                                   class="form-label">

                                Año

                            </label>

                            <input asp-for="Unidad.Año"
                                   type="number"
                                   class="form-control" />

                        </div>


                        <div class="col-md-3 mb-3">

                            <label asp-for="Unidad.Estado"
                                   class="form-label">

                                Estado

                            </label>

                            <select asp-for="Unidad.Estado"
                                    class="form-select">

                                <option>
                                    Disponible
                                </option>

                                <option>
                                    En patio
                                </option>

                                <option>
                                    En mantenimiento
                                </option>

                                <option>
                                    Fuera de servicio
                                </option>

                            </select>

                        </div>

                    </div>


                    <button type="submit"
                            class="btn btn-success">

                        💾 Guardar cambios

                    </button>


                    <a asp-page="/Unidades"
                       class="btn btn-secondary">

                        Cancelar

                    </a>

                </form>

            </div>

        </div>

    }

</div>