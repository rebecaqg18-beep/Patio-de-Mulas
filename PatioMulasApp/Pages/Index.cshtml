@page
@model IndexModel

@{
    ViewData["Title"] = "Panel Principal";
}


<div class="text-center">

    <h1 class="display-4">
        PatioMulas
    </h1>

    <p>
        Sistema de Gestión y Control de Información
    </p>

</div>


<div class="container mt-4">

    <div class="row">


        <!-- UNIDADES -->

        <div class="col-md-4 mb-3">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h3>🚛 Unidades</h3>

                    <p>
                        Registrar y consultar las unidades.
                    </p>

                    <a asp-page="/Unidades"
                       class="btn btn-primary">

                        Gestionar unidades

                    </a>

                </div>

            </div>

        </div>



        <!-- CONDUCTORES -->

        <div class="col-md-4 mb-3">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h3>👨‍✈️ Conductores</h3>

                    <p>
                        Registrar y consultar conductores.
                    </p>

                    <a asp-page="/Conductores"
                       class="btn btn-primary">

                        Gestionar conductores

                    </a>

                </div>

            </div>

        </div>



        <!-- MOVIMIENTOS -->

        <div class="col-md-4 mb-3">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h3>🔄 Movimientos</h3>

                    <p>
                        Registrar entradas y salidas.
                    </p>

                    <a asp-page="/Movimientos"
   class="btn btn-primary">

    Gestionar movimientos

</a>

                </div>

            </div>

        </div>


    </div>



    <div class="row mt-3">


        <!-- CONSULTAS -->

        <div class="col-md-6 mb-3">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h3>🔎 Consultas</h3>

                    <p>
                        Consultar información registrada.
                    </p>

                  <a asp-page="/Consultas"
   class="btn btn-secondary">

    Realizar consultas

</a>

                </div>

            </div>

        </div>



        <!-- REPORTES -->

        <div class="col-md-6 mb-3">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h3>📊 Reportes</h3>

                    <p>
                        Consultar información y generar reportes.
                    </p>

                    <button class="btn btn-secondary"
                            disabled>

                        Ver reportes

                    </button>

                </div>

            </div>

        </div>


    </div>

</div>