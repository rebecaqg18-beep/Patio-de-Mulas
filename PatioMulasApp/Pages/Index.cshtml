@page
@model IndexModel
@{
    ViewData["Title"] = "Panel Principal";
}

<div class="text-center">
    <h1 class="display-4">PatioMulas</h1>
    <p>Sistema de Gestión y Control de Información</p>
</div>

<div class="container mt-4">
    <div class="row">

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h3>🚛 Unidades</h3>
                    <p>Registrar y consultar las unidades.</p>
                    <button class="btn btn-primary">Gestionar unidades</button>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h3>👨‍✈️ Conductores</h3>
                    <p>Registrar y consultar conductores.</p>
                    <button class="btn btn-primary">Gestionar conductores</button>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h3>🔄 Movimientos</h3>
                    <p>Registrar entradas y salidas.</p>
                    <button class="btn btn-primary">Gestionar movimientos</button>
                </div>
            </div>
        </div>

    </div>

    <div class="row mt-3">

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h3>🔎 Consultas</h3>
                    <p>Consultar información registrada.</p>
                    <button class="btn btn-secondary">Realizar consultas</button>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h3>📊 Reportes</h3>
                    <p>Consultar información y generar reportes.</p>
                    <button class="btn btn-secondary">Ver reportes</button>
                </div>
            </div>
        </div>

    </div>
</div>