@page
@model PatioMulasApp.Pages.ConductoresModel

@{
    ViewData["Title"] = "Gestión de Conductores";
}

<div class="container mt-4">

    <div class="text-center mb-4">

        <h1>👨‍✈️ Gestión de Conductores</h1>

        <p>
            Registro, consulta y gestión de los conductores
            del patio de mulas.
        </p>

    </div>


    <!-- REGISTRAR CONDUCTOR -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <h4>Registrar conductor</h4>

        </div>

        <div class="card-body">

            <form method="post">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Conductor.Cedula"
                               class="form-label">

                            Cédula

                        </label>

                        <input asp-for="Conductor.Cedula"
                               class="form-control"
                               placeholder="Ej. 8-123-456" />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Conductor.Nombre"
                               class="form-label">

                            Nombre

                        </label>

                        <input asp-for="Conductor.Nombre"
                               class="form-control"
                               placeholder="Ej. Carlos" />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Conductor.Apellido"
                               class="form-label">

                            Apellido

                        </label>

                        <input asp-for="Conductor.Apellido"
                               class="form-control"
                               placeholder="Ej. Rodríguez" />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Conductor.Telefono"
                               class="form-label">

                            Teléfono

                        </label>

                        <input asp-for="Conductor.Telefono"
                               class="form-control"
                               placeholder="Ej. 6000-0000" />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="Conductor.Estado"
                               class="form-label">

                            Estado

                        </label>

                        <select asp-for="Conductor.Estado"
                                class="form-select">

                            <option value="">
                                Seleccione...
                            </option>

                            <option>
                                Activo
                            </option>

                            <option>
                                Inactivo
                            </option>

                            <option>
                                En licencia
                            </option>

                        </select>

                    </div>

                </div>


                <button type="submit"
                        class="btn btn-primary">

                    Registrar conductor

                </button>

            </form>

        </div>

    </div>



    <!-- BUSCADOR -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <h4>🔎 Buscar conductor</h4>

        </div>

        <div class="card-body">

            <form method="get">

                <div class="row align-items-end">

                    <div class="col-md-8 mb-3">

                        <label asp-for="Buscar"
                               class="form-label">

                            Buscar por cédula, nombre o apellido

                        </label>

                        <input asp-for="Buscar"
                               class="form-control"
                               placeholder="Ej. 8-123-456 o Carlos" />

                    </div>


                    <div class="col-md-2 mb-3">

                        <button type="submit"
                                class="btn btn-secondary w-100">

                            🔎 Buscar

                        </button>

                    </div>


                    <div class="col-md-2 mb-3">

                        <a asp-page="/Conductores"
                           class="btn btn-outline-secondary w-100">

                            Ver todos

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>



    <!-- CONDUCTORES REGISTRADOS -->

    <div class="card shadow-sm">

        <div class="card-header">

            <h4>📋 Conductores registrados</h4>

        </div>

        <div class="card-body">

            @if (Model.Conductores.Count == 0)
            {
                <p class="text-muted">

                    No se encontraron conductores.

                </p>
            }
            else
            {

                <div class="table-responsive">

                    <table class="table table-striped table-bordered">

                        <thead>

                            <tr>

                                <th>ID</th>
                                <th>Cédula</th>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Teléfono</th>
                                <th>Estado</th>
                                <th>Acciones</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var conductor in Model.Conductores)
                            {

                                <tr>

                                    <td>
                                        @conductor.Id
                                    </td>

                                    <td>
                                        @conductor.Cedula
                                    </td>

                                    <td>
                                        @conductor.Nombre
                                    </td>

                                    <td>
                                        @conductor.Apellido
                                    </td>

                                    <td>
                                        @conductor.Telefono
                                    </td>

                                    <td>
                                        @conductor.Estado
                                    </td>


                                    <td>

                                        <!-- EDITAR -->

                                        <form method="post"
                                              asp-page-handler="Editar"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@conductor.Id" />

                                            <button type="submit"
                                                    class="btn btn-warning btn-sm">

                                                ✏️ Editar

                                            </button>

                                        </form>


                                        <!-- ELIMINAR -->

                                        <form method="post"
                                              asp-page-handler="Eliminar"
                                              class="d-inline"
                                              onsubmit="return confirm('¿Está seguro de que desea eliminar este conductor?');">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@conductor.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm">

                                                🗑️ Eliminar

                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>



    <!-- FORMULARIO DE EDICIÓN -->

    @if (Model.Conductor.Id > 0)
    {

        <div class="card shadow-sm mt-4">

            <div class="card-header">

                <h4>✏️ Editar conductor</h4>

            </div>


            <div class="card-body">

                <form method="post"
                      asp-page-handler="GuardarCambios">

                    <input type="hidden"
                           asp-for="Conductor.Id" />


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="Conductor.Cedula"
                                   class="form-label">

                                Cédula

                            </label>

                            <input asp-for="Conductor.Cedula"
                                   class="form-control" />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="Conductor.Nombre"
                                   class="form-label">

                                Nombre

                            </label>

                            <input asp-for="Conductor.Nombre"
                                   class="form-control" />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="Conductor.Apellido"
                                   class="form-label">

                                Apellido

                            </label>

                            <input asp-for="Conductor.Apellido"
                                   class="form-control" />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="Conductor.Telefono"
                                   class="form-label">

                                Teléfono

                            </label>

                            <input asp-for="Conductor.Telefono"
                                   class="form-control" />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="Conductor.Estado"
                                   class="form-label">

                                Estado

                            </label>

                            <select asp-for="Conductor.Estado"
                                    class="form-select">

                                <option>
                                    Activo
                                </option>

                                <option>
                                    Inactivo
                                </option>

                                <option>
                                    En licencia
                                </option>

                            </select>

                        </div>

                    </div>


                    <button type="submit"
                            class="btn btn-success">

                        💾 Guardar cambios

                    </button>


                    <a asp-page="/Conductores"
                       class="btn btn-secondary">

                        Cancelar

                    </a>

                </form>

            </div>

        </div>

    }

</div>